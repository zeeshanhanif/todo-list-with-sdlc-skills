# Copy to .env for local development. NEVER commit a real .env (NFR-MAINT-003).
# In cloud environments these are Cloud Run environment variables set at deploy time, not files.

# Postgres (matches docker-compose.yml). Used by the API, the worker, and migrations.
DATABASE_URL=postgres://todo:todo@localhost:5432/todo

# API service
PORT=3001

# Web -> API base URL (server-side fetch in the Next.js shell)
API_URL=http://localhost:3001

# Email delivery worker (FEAT-007). Default provider "log" just logs the message
# (no external account needed). Set EMAIL_PROVIDER=smtp + SMTP_URL to really send.
EMAIL_PROVIDER=log
# SMTP_URL=smtps://user:pass@smtp.example.com:465   # when EMAIL_PROVIDER=smtp
EMAIL_FROM=To-Do <no-reply@todo.local>
PUBLIC_APP_URL=http://localhost:3000
# EMAIL_MAX_ATTEMPTS=5
# EMAIL_BATCH_SIZE=50
# EMAIL_BACKOFF_BASE_SECONDS=60
# EMAIL_BACKOFF_CAP_SECONDS=3600

# Soft-deleted task purge (FEAT-020, FR-TASK-015). The same worker run that
# drains the outbox also hard-deletes tasks whose retention clock has run out.
# 30 days is the SRS §3.4 default; it is configuration because that figure is
# still marked *(confirm)* there.
# TASK_RETENTION_DAYS=30
# PURGE_BATCH_SIZE=500

# Cross-device sync (FEAT-019, ADR-006). Default `none` publishes no signal and
# mints no token; the web client falls back to its adaptive refetch schedule,
# which meets NFR-PERF-004 without a socket. Everything below is needed ONLY to
# switch REALTIME_PROVIDER=supabase, and needs a provisioned Supabase project
# (then apply deploy/supabase/realtime-authorization.sql once).
REALTIME_PROVIDER=none
# SUPABASE_URL=                    # https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=        # anon/publishable key — public by design, sent to the browser
# SUPABASE_SERVICE_ROLE_KEY=       # SECRET — authenticates the API's broadcast POSTs
# SUPABASE_JWT_SECRET=             # SECRET — signs the short-lived Realtime tokens the API mints
# REALTIME_TOKEN_TTL_MINUTES=30    # minted token lifetime; the client re-mints at 80%
# REALTIME_PUBLISH_TIMEOUT_MS=250  # hard cap on one broadcast, so sync cannot spend the write budget
